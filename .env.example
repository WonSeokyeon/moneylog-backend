DB_URL=jdbc:postgresql://localhost:5432/moneylog_db
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=            # raw UTF-8 32자 이상 (Base64 디코드하지 않음)
JWT_EXPIRATION=86400000  # 밀리초 단위. 86400000 = 24시간 (AUTH-04)
CORS_ALLOWED_ORIGINS=http://localhost:3000
RECEIPT_VISION_API_KEY=      # 영수증 인식(TXN-13)에 쓰는 Anthropic API 키
